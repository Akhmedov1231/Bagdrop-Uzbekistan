# ============================================================
# Supabase — REQUIRED to run this app from Phase 1 onward.
# Get these from: Supabase Dashboard → Project Settings → API
# ============================================================

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" key — safe to expose in the browser.
# Used by the browser client and by server code acting AS the current user
# (so Row Level Security policies apply normally).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — SERVER-ONLY, NEVER prefix with NEXT_PUBLIC_, NEVER
# import into any "use client" file or expose to the browser. Bypasses
# Row Level Security entirely. Used only in trusted server code (e.g. the
# admin dashboard's own server actions, and internal system operations).
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# App
# ============================================================

# Used to build absolute URLs (QR redirect targets, notification links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Payments (placeholder only — see src/lib/paymentService.ts)
# No real Click/Payme credentials exist yet. Leave blank until a developer
# wires up a real provider adapter. Do not invent values here.
# ============================================================
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
